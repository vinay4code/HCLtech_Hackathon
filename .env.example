# LLM Provider Configuration: MOCK (High-fidelity offline), GEMINI, or OPENAI
LLM_PROVIDER=MOCK

# Optional Cloud API Keys (Leave blank to run 100% offline in deterministic MOCK mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Configuration
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2

# Vector Embedding Engine: FAST_HASH (Instant 0-latency), LOCAL_HF, or GEMINI
EMBEDDING_PROVIDER=FAST_HASH
